sh -c 'target="$1"; ready_json=$(gc ready --metadata-field "gc.routed_to=$target" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "hold:squad" --json --limit 0) || exit $?; legacy_candidates=$(gc ready --metadata-field "gc.run_target=$target" --metadata-field "gc.kind=workflow" --unassigned --exclude-type=epic --exclude-label "hold:mayor" --exclude-label "hold:external" --exclude-label "hold:squad" --json --sort oldest --limit 0) || exit $?; legacy_json=$(printf "%s" "$legacy_candidates" | jq '\''[.[] | select(((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.workflow_expanded"] // "") != "true"))]'\'') || exit $?; legacy_ephemeral_json=$({ bd query --json '\''ephemeral=true AND status=open'\'' --limit=0 | jq --arg target "$target" '\''[.[] | select((.assignee // "") == "") | select(((.metadata["gc.routed_to"] // "") == $target) or (((.metadata["gc.routed_to"] // "") == "") and ((.metadata["gc.run_target"] // "") == $target) and ((.metadata["gc.kind"] // "") == "workflow") and ((.metadata["gc.workflow_expanded"] // "") != "true"))) | select(((.issue_type // .type // "") != "epic")) | select(([ (.labels // [])[] | select(((type == "string") and (ltrimstr(" ") | ascii_downcase | startswith("hold:")))) ] | length) == 0) | select(((.dependency_count // 0) == 0))] | sort_by(.created_at // "", .id // "")'\''; } || printf "[]"); printf "%s\n%s\n%s\n" "$ready_json" "$legacy_json" "$legacy_ephemeral_json" | jq -s '\''(add // []) | [.[] | select(([ (.labels // [])[] | select(((type == "string") and (ltrimstr(" ") | ascii_downcase | startswith("hold:")))) ] | length) == 0)] | unique_by(.id) | length'\''' -- worker-pool